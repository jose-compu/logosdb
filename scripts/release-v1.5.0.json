  "headline_html": "<h2>1.5.0 — Live ids and bulk export</h2>\n        <p class=\"section-intro\">\n          Core, PyPI, and npm <code>logosdb</code> at <strong>1.5.0</strong>. List active row ids, read decoded float32 vectors in bulk, or stream live rows to NDJSON without looping <code>get()</code> on every id (#135).\n          Node adds <code>liveIds()</code>, <code>rawVectors()</code>, and <code>exportNdjson()</code>; C and Python expose the same C API.\n        </p>\n\n        <table class=\"pkg-table\" aria-label=\"Published package versions\">\n          <thead>\n            <tr><th>Package</th><th>Version</th><th>Registry</th></tr>\n          </thead>\n          <tbody>\n            <tr><td><code>logosdb</code></td><td><strong>1.5.0</strong></td><td>PyPI, npm</td></tr>\n            <tr><td><code>logosdb-mcp-server</code></td><td><strong>1.4.4</strong></td><td>npm (<code>^1.5.0</code>)</td></tr>\n            <tr><td><code>n8n-nodes-logosdb</code></td><td>1.0.3</td><td>npm (unchanged)</td></tr>\n          </tbody>\n        </table>\n\n        <a class=\"release-banner\" href=\"https://github.com/jose-compu/logosdb/releases/tag/v1.5.0\" target=\"_blank\" rel=\"noopener\">\n          <img src=\"https://github.com/jose-compu/logosdb/releases/download/v1.5.0/linkedin-v1.5.0.png\" alt=\"LogosDB 1.5.0 release\" width=\"1200\" height=\"627\" loading=\"lazy\" />\n        </a>"
}