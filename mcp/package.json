{
  "name": "logosdb-mcp-server",
  "version": "1.2.0",
  "mcpName": "io.github.jose-compu/logosdb-mcp-server",
  "description": "MCP server for LogosDB: local semantic memory, file indexing, and hybrid search for Claude Code, Cursor, and other MCP clients",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "readme": "README.md",
  "bin": {
    "logosdb-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/mcp-stdio-smoke.mjs",
    "test": "npm run build && node --test dist/chunker.test.js dist/security.test.js dist/file-index-manifest.test.js dist/gitignore-walker.test.js dist/hybrid.test.js dist/metadata-filter.test.js dist/quota.test.js dist/store.test.js dist/cli.test.js && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jose-compu/logosdb.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "logosdb",
    "vector-database",
    "semantic-search",
    "claude-code",
    "cursor",
    "embeddings",
    "rag",
    "hybrid-search"
  ],
  "author": "Jose",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jose-compu/logosdb/issues"
  },
  "homepage": "https://github.com/jose-compu/logosdb/tree/main/mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "ignore": "^7.0.5",
    "logosdb": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
